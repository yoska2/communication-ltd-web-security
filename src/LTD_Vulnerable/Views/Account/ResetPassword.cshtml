@{
    ViewData["Title"] = "איפוס סיסמה";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" />
}

<div class="register-container">
    <div class="register-card">
        <h1>Communication_LTD</h1>
        <p class="subtitle">איפוס סיסמה</p>

        @Html.ValidationSummary(false, "", new { @class = "error-message" })

        <form  method="post">
            <div class="form-group">
                <label>סיסמה חדשה</label>
                <input type="password" name="y" required />
            </div>

            <div class="form-group">
                <label>אימות סיסמה חדשה</label>
                <input type="password" name="z" required />
            </div>

            <button type="submit" class="btn-register">
                עדכן סיסמה
            </button>
        </form>
    </div>
</div>
