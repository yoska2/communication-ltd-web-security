@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" />
}

<div class="register-container">
    <div class="register-card">
        <h1>Communication_LTD</h1>
        <p class="subtitle">יצירת משתמש חדש</p>

        <form method="post">

            <!-- הצגת כל שגיאות הוולידציה -->
            @Html.ValidationSummary(false, "", new { @class = "error-message" })

            <div class="form-group">
                <label>שם משתמש</label>
                <input type="text" name="username" dir="ltr" required />
            </div>

            <div class="form-group">
                <label>אימייל</label>
                <input type="email" name="email"  dir="ltr" required />
            </div>

            <div class="form-group">
                <label>סיסמה</label>
                <input type="password" name="password" dir="ltr" required />
            </div>

            <button type="submit" class="btn-register">הרשמה</button>
        </form>
    </div>
</div>
