@{
    ViewData["Title"] = "Welcome";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

<div class="index-background">
    <!-- רקע מונפש -->
    <div class="animated-grid"></div>

    <!-- תוכן -->
    <div class="index-container">
        <div class="index-card">

            <h1 class="main-title">
                Welcome to <br />
                <span>Communication LTD</span>
            </h1>

            <p class="description">
                מערכת ארגונית מתקדמת לניהול לקוחות, משתמשים
                וחבילות תקשורת – עבור עובדי החברה בלבד
            </p>

            <div class="buttons-wrapper">
                <form method="post" action="/Home/GoToLogin">
                    <button class="btn primary">התחברות</button>
                </form>

                <form method="post" action="/Home/GoToRegister">
                    <button class="btn secondary">הרשמה</button>
                </form>
            </div>

        </div>
    </div>
</div>
